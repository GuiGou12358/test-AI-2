{
  "name": "indexer",
  "version": "1.0.0",
  "description": "Indexer SubQuery pour les données onchain des contrats Solidity",
  "scripts": {
    "build": "subql build",
    "codegen": "subql codegen",
    "dev": "docker-compose pull && docker-compose up",
    "start:docker": "docker-compose up",
    "start:local": "subql-node -d .",
    "query:local": "subql-query -d .",
    "publish": "subql publish",
    "validate": "subql validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "subquery",
    "indexer",
    "evm",
    "ethereum",
    "graphql"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@subql/cli": "6.6.2",
    "@subql/node": "^6.4.6",
    "@subql/query": "2.25.0",
    "@subql/types": "3.15.0",
    "@subql/types-ethereum": "4.2.3",
    "@types/node": "25.3.2",
    "eslint": "10.0.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dependencies": {
    "@subql/node-ethereum": "^6.0.0"
  }
}
